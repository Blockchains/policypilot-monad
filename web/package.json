{
  "name": "policypilot-web",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/gen-icons.mjs && node scripts/write-corpus.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "node --test --experimental-strip-types src/lib/activityCore.test.ts src/lib/monadefi.test.ts src/lib/spend.test.ts src/lib/passkey.test.ts src/lib/positions.test.ts src/lib/preflight.test.ts src/lib/journey.test.ts src/lib/holdings.test.ts src/lib/momentum.test.ts src/lib/momentumKeeper.test.ts src/lib/momentumDepth.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "momentum:job": "node --no-warnings --experimental-strip-types scripts/momentum-job.mts"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "2.21.0",
    "lucide-react": "0.468.0",
    "@category-labs/mera": "0.2.0",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/react": "19.1.12",
    "@types/node": "22.7.5",
    "tailwindcss": "3.4.14",
    "postcss": "8.4.47",
    "autoprefixer": "10.4.20"
  },
  "overrides": {
    "@category-labs/mera": {
      "viem": "$viem"
    }
  }
}
